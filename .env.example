APP_NAME="AAS School Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Karachi
APP_URL=http://localhost/imran/school-management-api/public
# Main domain; each school opens at <subdomain>.APP_DOMAIN (e.g. bfs.localhost)
APP_DOMAIN=localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=school_management
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Front-end origins allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# SMS: "log" only stores messages in sms_logs table. "http" posts to SMS_API_URL.
SMS_DRIVER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=SCHOOL

# WhatsApp: "log" only stores messages. "cloud" uses Meta WhatsApp Cloud API.
WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
